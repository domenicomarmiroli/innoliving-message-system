# Copia in .env e compila. NON committare mai .env.

# --- Database -------------------------------------------------------
# Supavisor SHARED POOLER in session mode, porta 5432.
# NON usare la connessione diretta db.<ref>.supabase.co: è IPv6-only
# e Render non la raggiunge.
# Formato: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Shopify --------------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Microsoft 365 / Graph ------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
MS_WEBHOOK_CLIENT_STATE=

# --- Servizio -------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
