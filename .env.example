# Copia in .env e compila. NON committare mai .env.

# --- Database -------------------------------------------------------
# Supavisor SHARED POOLER in session mode, porta 5432.
# NON usare la connessione diretta db.<ref>.supabase.co: è IPv6-only
# e Render non la raggiunge.
SUPABASE_DB_URL=

# --- Shopify --------------------------------------------------------
SHOPIFY_SHOP=inshopping-10.myshopify.com

# Due modi di autenticarsi, scegline uno.
#
# A) App del Dev Dashboard (l'unica creabile oggi): il worker si procura
#    da solo un token valido 24 ore scambiando queste due credenziali.
#    Le trovi in dev.shopify.com → la tua app → App settings → Credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# B) Vecchia app creata dall'admin del negozio: token statico shpat_...
#    Se valorizzato ha la precedenza sulle due sopra.
SHOPIFY_ADMIN_TOKEN=

# Firma dei webhook. Con un'app del Dev Dashboard è lo stesso valore del
# client secret; con i webhook creati da Impostazioni → Notifiche è il
# segreto condiviso mostrato in fondo a quella pagina.
SHOPIFY_WEBHOOK_SECRET=

# --- Casella assistenza: IMAP + SMTP --------------------------------
# Trasporto attuale. Con Gmail servono la verifica in due passaggi attiva
# e una "password per app" (myaccount.google.com/apppasswords).
# I 16 caratteri vanno incollati SENZA spazi — quelli che Google mostra
# sono solo grafici. Il worker li toglie comunque, ma meglio non fidarsi.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Ogni quanti secondi rileggere la casella. IMAP non notifica: bisogna
# chiedere. A qualche decina di messaggi al giorno, 60 è abbondante.
MAIL_POLL_SECONDS=60
# Cartella da leggere. Su Gmail le cartelle IMAP sono le etichette.
MAIL_FOLDER=INBOX

# --- Mirakl (un operatore per riga) ---------------------------------
# L'URL NON va qui: sta in channel_account.config.endpoint, e il nome
# della variabile che contiene la chiave sta in channel_account.secret_ref.
# Così aggiungere un operatore è una riga di SQL più una variabile, e nel
# codice non finisce nessun indirizzo di nessun cliente.
#
# La chiave si genera nel back office Mirakl: il tuo nome in alto a
# destra -> Le mie impostazioni -> scheda "API key".
MIRAKL_MMS_KEY=
# MIRAKL_LMFR_KEY=

# --- Bozze AI (passo 07) ---------------------------------------------
# Senza ANTHROPIC_API_KEY la rotta /threads/draft resta disattivata: le
# bozze sono un aiuto in più, non devono impedire al resto di funzionare.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Microsoft 365 / Graph ------------------------------------------
# Sostituzione prevista per IMAP/SMTP quando la casella sarà su
# Microsoft 365: cambia il modulo del connettore, non il resto.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
MS_WEBHOOK_CLIENT_STATE=

# --- Protezione degli endpoint di invio ------------------------------
# Due modi di autenticarsi alla rotta /threads/reply, e bastano entrambi
# separatamente. Se NESSUNO dei due è impostato, la rotta non viene
# registrata affatto: un endpoint aperto che spedisce dalla tua identità
# venditore è troppo pericoloso per essere il comportamento predefinito.

# A) Per chiamate da server a server (automazioni), non per l'interfaccia.
# Segreto condiviso, almeno 16 caratteri, generato a caso.
WORKER_API_TOKEN=

# B) Per l'agente che scrive dall'interfaccia Lovable: il worker verifica
# la sessione chiedendo a Supabase Auth di chi è il token, invece di
# tenere un segreto condiviso col browser. Sono gli stessi valori — non
# sensibili — già nel bundle di Lovable (Project Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origini autorizzate a chiamare /threads/reply dal browser (CORS),
# separate da virgola. Senza questa, l'interfaccia Lovable vede un
# errore di rete: il browser blocca la richiesta prima che arrivi qui.
INTERFACCIA_ORIGINS=https://fluent-desk-hub.lovable.app,https://id-preview--1431a4ff-db5b-4a8f-9ed6-0a2c00918345.lovable.app

# --- Allegati: caricamento su Supabase Storage -----------------------
# La service_role key: bypassa RLS come SUPABASE_DB_URL. Non va MAI data
# a Lovable né a nulla che finisca in un bundle servito al browser.
# Senza questa, gli allegati entrano comunque ma solo come metadato.
SUPABASE_SERVICE_ROLE_KEY=

# --- Servizio -------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
