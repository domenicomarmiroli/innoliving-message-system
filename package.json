{
  "name": "hub-messaggi-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backfill:shopify": "tsx src/commands/backfill-shopify.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "mail:check": "tsx src/commands/mail-check.ts",
    "mail:ripulisci": "tsx src/commands/mail-ripulisci.ts",
    "mirakl:check": "tsx src/commands/mirakl-check.ts",
    "shopify:webhooks": "tsx src/commands/shopify-webhooks.ts",
    "shopify:sync": "tsx src/commands/shopify-sync.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.16",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
